{
  "name": "n8n assignment - form to email",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Valida e sanitiza a entrada do formulario publico ANTES de qualquer\n// processamento. A deteccao de prompt injection acontece aqui, em codigo\n// deterministico, e nao dentro do prompt: o LLM nao e responsavel pela\n// propria defesa.\n\nconst LIMITES = { nome: 80, email: 120, filme: 800 };\nconst LIMITE_ABSURDO = 4000;\n\n// Padroes de tentativa de manipulacao do agente.\nconst REGRAS = [\n  [/ignor\\w*\\s+(as\\s+|todas\\s+as\\s+|any\\s+|all\\s+)?(instru|previous|above|acima|anterior)/i,\n   'tentativa de sobrescrever instrucoes'],\n  [/desconsider\\w*\\s+(as\\s+)?(instru|regras)|esque[cc]a\\s+(tudo|as\\s+instru)/i,\n   'tentativa de sobrescrever instrucoes'],\n  [/(voce|you)\\s+(agora\\s+)?(e|are|is)\\s+(um|uma|a|an)\\b/i,\n   'tentativa de redefinir o papel do modelo'],\n  [/\\b(aja|atue|act|behave)\\s+como\\b|\\bact\\s+as\\b|assuma\\s+o\\s+papel/i,\n   'tentativa de redefinir o papel do modelo'],\n  [/\\b(system|assistant|user)\\s*:/i,\n   'simulacao de turno de conversa'],\n  [/<\\/?\\s*dados_usuario\\s*>/i,\n   'tentativa de forjar o delimitador'],\n  [/<\\|[\\s\\S]{0,40}?\\|>|```/,\n   'delimitador de prompt ou bloco de codigo'],\n  [/(revele|mostre|repita|reveal|show|repeat|print)\\b[\\s\\S]{0,40}?\\b(prompt|instru|regras|system)/i,\n   'tentativa de exfiltrar o prompt'],\n  [/(envie|encaminhe|send|forward)\\b[\\s\\S]{0,40}?@/i,\n   'tentativa de redirecionar o e-mail'],\n  [/nova\\s+instru|new\\s+instruction|em\\s+vez\\s+disso|instead\\s+of/i,\n   'injecao de nova instrucao'],\n];\n\n// Troca caracteres de controle por espaco sem depender de escapes de regex.\nconst semControle = (s) => s.split('')\n  .map((ch) => (ch.charCodeAt(0) < 32 || ch.charCodeAt(0) === 127) ? ' ' : ch)\n  .join('');\n\nconst limpa = (v, max) =>\n  semControle(String(v == null ? '' : v))\n    .replace(/[<>]/g, '')                        // impede forjar o delimitador\n    .replace(/\\s+/g, ' ')                        // colapsa quebras de linha\n    .trim()\n    .slice(0, max);\n\nconst saida = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const bruto = {\n    nome:  j['Qual seu nome?'],\n    email: j['Qual seu email?'],\n    idade: j['Quantos anos voce tem?'] !== undefined\n             ? j['Quantos anos voce tem?']\n             : j['Quantos anos você tem?'],\n    filme: j['Qual seu filme favorito? descreva por que voce gosta dele'] !== undefined\n             ? j['Qual seu filme favorito? descreva por que voce gosta dele']\n             : j['Qual seu filme favorito? descreva por que você gosta dele'],\n  };\n\n  const motivos = [];\n\n  // 1) Deteccao sobre o texto ORIGINAL, antes da limpeza: sanitizar primeiro\n  //    apagaria justamente as evidencias que queremos registrar.\n  const textoLivre = String(bruto.nome == null ? '' : bruto.nome) + ' ' +\n                     String(bruto.filme == null ? '' : bruto.filme);\n  for (const [re, motivo] of REGRAS) {\n    if (re.test(textoLivre) && motivos.indexOf(motivo) === -1) motivos.push(motivo);\n  }\n  if (textoLivre.length > LIMITE_ABSURDO) motivos.push('conteudo excessivamente longo');\n\n  // 2) Validacao de campos: nenhum campo do formulario e obrigatorio no n8n,\n  //    entao a submissao vazia ou malformada precisa ser barrada aqui.\n  const nome  = limpa(bruto.nome,  LIMITES.nome);\n  const email = limpa(bruto.email, LIMITES.email);\n  const filme = limpa(bruto.filme, LIMITES.filme);\n  const idade = Number(bruto.idade);\n\n  if (!nome) motivos.push('nome ausente');\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) motivos.push('email ausente ou invalido');\n  if (!Number.isInteger(idade) || idade < 0 || idade > 120) motivos.push('idade ausente ou invalida');\n\n  saida.push({\n    json: {\n      nome: nome,\n      email: email,\n      filme: filme,\n      idade: Number.isInteger(idade) ? idade : -1,\n      submittedAt: limpa(j.submittedAt, 40),\n      suspeito: motivos.length > 0,\n      motivos: motivos.join('; '),\n    },\n  });\n}\n\nreturn saida;\n"
      },
